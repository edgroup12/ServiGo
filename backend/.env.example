NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.your_id.mongodb.net/servigo?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-frontend.example
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SEED_DB=false
# Local-only convenience. Keep false or unset in production.
USE_MEMORY_DB=false
