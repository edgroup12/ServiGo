{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "rm -rf api/backend && cp -R ../backend api/backend && rm -rf api/backend/node_modules api/backend/test && npm install --omit=dev --prefix api/backend && npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "api/backend/**",
            "memory": 512,
            "maxDuration": 30
        }
    }
}