{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm install --prefix ../backend && npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "../backend/**",
            "memory": 512,
            "maxDuration": 30
        }
    }
}